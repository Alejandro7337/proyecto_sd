# Tu Espacio · API — variables de entorno (copia a .env para desarrollo local).
# Ningún valor aquí es secreto: son valores de desarrollo. En otros ambientes, inyecta secretos
# desde el gestor del proveedor (nunca los subas al repositorio).

NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://tuespacio:local-dev-only@localhost:5432/tuespacio
DATABASE_POOL_MAX=10
# false | true (verifica certificado) | no-verify
DATABASE_SSL=false

# Orígenes web permitidos (la app nativa no usa CORS). En producción es obligatorio.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Detrás de un balanceador: número de saltos de proxy de confianza (p. ej. 1).
TRUST_PROXY=false

# Sesiones (tokens opacos con rotación de refresh)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30
# outbox = correo simulado guardado en la base (visible en /demo/outbox con DEMO_TOOLS) | disabled
MAIL_PROVIDER=outbox

# Pagos: simulated (por defecto) | gateway (adaptador preparado, proveedor por definir)
PAYMENT_PROVIDER=simulated
# Cobro real: solo con PAYMENT_PROVIDER=gateway, NODE_ENV=production y DEMO_TOOLS=false.
PAYMENTS_LIVE=false
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_TIMEOUT_MS=4000
PAYMENT_MAX_ATTEMPTS=3
SIM_GATEWAY_LATENCY_MS=250

# Reglas operativas [supuestos documentados en docs/PENDING_BUSINESS_DECISIONS.md]
HOLD_MINUTES=10
# Comisión de espacios particulares (0–0.5). Vacío = por definir (no se cobra comisión).
HOST_COMMISSION_RATE=
EARLY_CHECKIN_MIN=15
NO_SHOW_GRACE_MIN=30
WALKIN_HORIZON_MIN=180
BOOKING_HORIZON_DAYS=7

# Herramientas de demo: escenarios de falla, registro T0, correo simulado, reinicio.
DEMO_TOOLS=true
ALLOW_DEMO_TOOLS_IN_PRODUCTION=false
# Requerido para POST /demo/reset (mín. 24 caracteres). Vacío = reinicio por API deshabilitado.
DEMO_RESET_TOKEN=
# Pausa entre pasos de la saga para que el procesamiento sea visible en la demo (0 en producción).
SAGA_STEP_DELAY_MS=250

# Límites de peticiones: memory (una instancia) | postgres (varias réplicas)
RATE_LIMIT_STORE=memory
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_GLOBAL_PER_MIN=600

SWEEPER_ENABLED=true
SWEEPER_INTERVAL_MS=30000
LOG_LEVEL=info

# Solo para arranque en contenedor de desarrollo
MIGRATE_ON_START=false
SEED_ON_START=false
