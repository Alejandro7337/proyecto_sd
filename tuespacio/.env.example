# Copia este archivo como .env; nunca lo subas a Git.
# Inicio local: python3 -m server.run --regions co --env-file .env
APP_ENV=development
PAYMENT_PROVIDER=demo

# Cambia PAYMENT_PROVIDER=mercadopago para conectar la cuenta existente.
# Estas cuatro variables son privadas; nunca uses prefijo EXPO_PUBLIC_.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_LIVE_MODE=false
# Origen HTTPS público del gateway, requerido para retornos y webhooks.
APP_PUBLIC_URL=

RECEIPT_SELLER_NAME='Tu Espacio'
RECEIPT_SELLER_TAX_ID=

# Desarrollo: Photon público, sólo búsquedas explícitas y con caché.
# Producción: endpoint Photon propio o proveedor compatible con SLA.
GEOCODER_URL=https://photon.komoot.io/api/

# Sólo para compose.production.yaml: dominio DNS del comercio, sin https://.
PUBLIC_HOST=
