# Variables PÚBLICAS de la app. Todo EXPO_PUBLIC_* se incrusta en el paquete que se instala en
# el teléfono y cualquiera puede leerlo: NUNCA pongas aquí llaves, contraseñas ni secretos.
# Copia este archivo como .env.local (ignorado por git) y ajusta los valores.

# mock: backend simulado dentro de la app (modo demo, datos ficticios, sin red).
# http: servidor real de tuespacio/server.
EXPO_PUBLIC_API_MODE=mock

# Obligatoria en modo http. Desde un teléfono físico usa la IP LAN del computador, no localhost.
# Ejemplos: http://192.168.1.20:8080   ·   https://api.tu-dominio.co
EXPO_PUBLIC_API_URL=

# Tiempo máximo de espera por petición HTTP (ms). Por defecto 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=15000
